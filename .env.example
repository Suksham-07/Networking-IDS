# =============================================================================
# NexIDS Environment Configuration Example
# =============================================================================
# Copy this file to .env and customize as needed.
# Note: Never commit real passwords, API tokens, or secrets to version control.
# =============================================================================

# Application Execution Mode: "demo" (safe synthetic traffic), "live", "web", or "cli"
NEXIDS_MODE=demo

# Web SOC Dashboard Settings
NEXIDS_HOST=127.0.0.1
NEXIDS_PORT=5000
NEXIDS_REFRESH_INTERVAL=3

# Logging Level: DEBUG, INFO, WARNING, ERROR
NEXIDS_LOG_LEVEL=INFO

# Storage Directories (Relative or Absolute paths)
NEXIDS_REPORT_DIR=reports
NEXIDS_LOG_DIR=logs

# Network Capture Settings
# Interface name (e.g. eth0, wlan0, or leave empty for auto-detection)
NEXIDS_INTERFACE=
# BPF Capture Filter (e.g. "tcp", "port 80", or leave empty to capture all traffic)
NEXIDS_BPF_FILTER=
# Session limits (0 = run indefinitely / unlimited)
NEXIDS_CAPTURE_TIMEOUT=0
NEXIDS_CAPTURE_LIMIT=0

# Detection Engine Thresholds
NEXIDS_PORT_SCAN_THRESHOLD=15
NEXIDS_PORT_SCAN_WINDOW=10.0
NEXIDS_ICMP_FLOOD_THRESHOLD=50
NEXIDS_ICMP_WINDOW=5.0
NEXIDS_ARP_SPOOF_MAC_CHANGE=true
NEXIDS_TRAFFIC_BYTES_THRESHOLD=10000000
NEXIDS_TRAFFIC_WINDOW=10.0
NEXIDS_MIN_ALERT_CONFIDENCE=0.5
